(text "C3 | FOUR ACTUAL-RAIL WINDOW MONITORS" (at 15.24 15.24 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1316e097-fc3b-595e-b0f1-e0720ce53f41"))
(text "All monitor VDD pins use MCU control power. AVDD and DVDD SENSE are separate remote wires, not substitute rail feeds." (at 15.24 27.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e923e24f-5746-5136-bf94-9fcc5181e640"))
(text "CT via 10k to MCU selects nominal 200 ms release (140-260 ms). Sense pulldowns are local to this board." (at 15.24 248.92 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bcde4005-4fc9-5df8-9660-cdb56958268a"))
(text "30 us maximum fault detection applies only at specified 5% overdrive. No unconditional pre-E1 shutdown guarantee." (at 15.24 256.54 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ccf9c866-d379-551b-bfe6-77be965f9994"))
